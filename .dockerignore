# Version control
.git
.gitignore

# Dependencies (re-installed inside the image)
node_modules
**/node_modules

# Build outputs (re-built inside the image)
.next
**/.next
dist
**/dist
.turbo
**/.turbo

# TS incremental cache
**/tsconfig.tsbuildinfo

# Editor / OS junk
.vscode
.idea
.DS_Store
Thumbs.db

# Env / secrets — must not leak into images
.env
.env.*
!.env.example

# Docs / misc
*.md
README.md

# Docker artifacts (avoid recursive context noise)
docker-compose*.yml
.dockerignore
