# FreshOrder docker-compose 환경 변수 (예시)
# 실제 .env 는 git에 커밋하지 말 것

# DB
DB_NAME=freshorder
DB_USER=freshorder
DB_PASSWORD=change-me

# Redis
REDIS_PASSWORD=change-me

# JWT
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# 프론트 → 백엔드 API 베이스 URL
NEXT_PUBLIC_API_URL=/api
VITE_API_URL=/api
